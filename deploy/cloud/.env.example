# Online-Instanz (README.md daneben). Als .env neben compose.yaml speichern, chmod 600.
LAGEMONITOR_PUBLIC_URL=https://lagemonitor.iuk-ue.de/monitor
# OIDC-Client „Lagemonitor online“ in Pocket ID, Callback <PUBLIC_URL>/auth/callback
LAGEMONITOR_OIDC_ISSUER=https://id.iuk-ue.de
LAGEMONITOR_OIDC_CLIENT_ID=
LAGEMONITOR_OIDC_CLIENT_SECRET=
# Zugang aus der Suite (Lagemonitor → Zugänge für den Monitor), eigener Zugang je Instanz
LAGEMONITOR_SUITE_URL=https://lagemonitor.iuk-ue.de
LAGEMONITOR_SUITE_TOKEN=
